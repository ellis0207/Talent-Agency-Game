; Engine configuration file.
; Godot edits this file itself when you change Project Settings.
; It is plain text so it diffs cleanly in Git.

config_version=5

[application]

config/name="Talent Agency Game"
config/description="Run a talent agency: sign athletes, musicians, actors and models, guide their careers and build an empire. (Working title.)"
config/version="0.0.1-phase0"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/core/game_state.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
